    "pattern_match_implies_delivery",
    "request_response_fan_out",
    "same_repository_implies_same_deployment",
    "transport_equivalence",
    "unsupported_provider_registered"
  ],
  "cases": [
    {
      "caseId": "microservices-client-binding-ambiguous",
      "fixture": "transports.ts.txt",
      "classification": "negative",
      "topology": "not_applicable",
      "sourceMarkers": [
        "D0_CASE:microservices-client-binding-ambiguous"
      ],
      "expectation": {
        "producer": "unknown",
        "handler": "absent",
        "match": "unknown",
        "activation": "eager",
        "boundary": "unknown",
        "causalClass": "none"
      },
      "mustEmit": [
        "uncertainty_classification"
