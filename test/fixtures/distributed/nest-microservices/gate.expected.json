          "Inject",
          "Injectable",
          "Module"
        ]
      },
      {
        "name": "@nestjs/core",
        "version": "11.2.1",
        "sourceUrl": "https://github.com/nestjs/nest",
        "declarationSurface": [
          "INestApplication.connectMicroservice",
          "NestFactory.createMicroservice"
