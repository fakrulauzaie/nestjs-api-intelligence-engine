      "https://docs.nestjs.com/techniques/queues",
      "https://github.com/nestjs/bull",
      "https://github.com/taskforcesh/bullmq"
    ],
    "decisions": [
      "BullMQ WorkerHost handlers are queue-wide until a separately proven branch-slicing rule exists.",
      "Legacy Bull Process decorators remain outside the BullMQ-first Phase 35 acceptance scope.",
      "Local processors are delivery candidates across a broker boundary and never proof of runtime delivery.",
      "Producer-only queues are normal open-world boundaries and never missing-consumer failures."
    ],
    "rationale": "The bounded BullMQ surface provides sufficient endpoint-to-worker impact value to justify Phase 35 while preserving explicit open-world and branch-analysis limits."
  }
