  "cases": [
    {
      "caseId": "bullmq-ambiguous-workers",
      "technology": "bullmq",
      "topology": "ambiguous",
      "sources": [
        {
          "serviceNamespace": "report-api",
          "role": "producer",
          "fixture": "bullmq/report-api-producer.ts.txt"
        },
        {
          "serviceNamespace": "report-worker-a",
          "role": "consumer",
          "fixture": "bullmq/report-worker-consumer.ts.txt"
        },
        {
          "serviceNamespace": "report-worker-b",
          "role": "consumer",
          "fixture": "bullmq/report-worker-consumer.ts.txt"
        }
      ],
      "contractKey": "{\"job\":\"generate-pdf\",\"queue\":\"reports\",\"targetKind\":\"job_queue\",\"technology\":\"bullmq\"}",
      "realmBindings": [
        {
          "serviceNamespace": "report-api",
          "role": "producer",
          "brokerAlias": "shared-bull",
          "environmentAlias": "test",
          "transport": "bullmq",
          "destinationKind": "queue",
          "destinationValue": "reports"
        },
        {
          "serviceNamespace": "report-worker-a",
          "role": "consumer",
          "brokerAlias": "shared-bull",
          "environmentAlias": "test",
          "transport": "bullmq",
          "destinationKind": "queue",
          "destinationValue": "reports"
        },
        {
          "serviceNamespace": "report-worker-b",
          "role": "consumer",
          "brokerAlias": "shared-bull",
          "environmentAlias": "test",
          "transport": "bullmq",
          "destinationKind": "queue",
          "destinationValue": "reports"
        }
      ],
      "expected": {
        "state": "ambiguous",
        "unmatchedReason": null,
        "ambiguityReason": "multiple_job_consumers",
        "provenCrossServiceEdge": false
      },
      "mustNotInfer": ["broker_delivery_guaranteed", "cross_service_causal_path"],
      "rationale": "Two declared workers for one job remain explicit candidates; the corpus does not select a runtime worker."
    },
